with "../ada_esp32s3/crates/esp32s3_rts/esp32s3_rts.gpr";
with "../ada_esp32s3/libs/esp32s3_hal/esp32s3_hal.gpr";
with "vendor/inflate.gpr";

--  sxos, a bare-metal e-reader for the Xteink X4 Pro (ESP32-S3).  The
--  portable units in src/core are SPARK, proved free of run-time errors
--  through the host preview project; src/device holds the hardware drivers.
project SXOS is
   for Target use "xtensa-esp32-elf";
   for Runtime ("Ada") use Esp32s3_Rts.Runtime_Path;
   for Source_Dirs use ("src/core", "src/device");
   for Object_Dir use "obj";
   for Main use ("main.adb");

   package Builder is
      for Executable ("main.adb") use "ada_app.o";
   end Builder;

   package Binder is
      for Switches ("Ada") use ("-D16k", "-Q2", "-Mada_main");
   end Binder;

   package Compiler is
      --  No -gnata on the target: contracts are checked in the host
      --  preview build, which compiles the same core.
      Base := ("-O2", "-g", "-gnat2022");
      for Switches ("Ada") use Base;

      --  Units proved free of run-time errors (SPARK in spec and body) run
      --  without checks.  Everything else keeps them, including the
      --  instances of the proved generics (Fat32, Card_Scan, Store_Log) in
      --  src/device: an instance takes its instantiating unit's switches.
      --  A unit that becomes fully SPARK and proved belongs on this list.
      --  Truetype.Identity is not: its body compares access values.
      Proved := Base & ("-gnatp");
      for Switches ("bitmap_text.adb") use Proved;
      for Switches ("bytes.ads") use Proved;
      for Switches ("fallback.adb") use Proved;
      for Switches ("font_catalog.adb") use Proved;
      for Switches ("hyphenation.adb") use Proved;
      for Switches ("language_guess.adb") use Proved;
      for Switches ("library_view.adb") use Proved;
      for Switches ("mono_frame.adb") use Proved;
      for Switches ("opf.adb") use Proved;
      for Switches ("page_layout.adb") use Proved;
      for Switches ("plain_text.adb") use Proved;
      for Switches ("reader_view.adb") use Proved;
      for Switches ("reading_settings.adb") use Proved;
      for Switches ("settings_view.adb") use Proved;
      for Switches ("shelf.adb") use Proved;
      for Switches ("sleep_view.adb") use Proved;
      for Switches ("status_bar.adb") use Proved;
      for Switches ("store_record.adb") use Proved;
      for Switches ("text_metrics.adb") use Proved;
      for Switches ("text_raster.adb") use Proved;
      for Switches ("toc.adb") use Proved;
      for Switches ("toc_view.adb") use Proved;
      for Switches ("truetype.adb") use Proved;
      for Switches ("truetype-raster.adb") use Proved;
      for Switches ("utf8.adb") use Proved;
      for Switches ("x4_font.ads") use Proved;
      for Switches ("xhtml_text.adb") use Proved;
      for Switches ("xml_scan.adb") use Proved;
      for Switches ("zip.adb") use Proved;
   end Compiler;

   package Linker is
      for Default_Switches ("Ada") use ("-Wl,-r", "-nostdlib");
   end Linker;
end SXOS;
