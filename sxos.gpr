with "../ada_esp32s3/crates/esp32s3_rts/esp32s3_rts.gpr";
with "../ada_esp32s3/libs/esp32s3_hal/esp32s3_hal.gpr";

--  Experimental Xteink X4 Pro application.  This project deliberately does
--  not enable SPARK or proof tooling; the SoC is ESP32-S3, while panel wiring
--  and controller details still need verification against the physical unit.
project SXOS is
   for Target use "xtensa-esp32-elf";
   for Runtime ("Ada") use Esp32s3_Rts.Runtime_Path;
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Main use ("main.adb");

   package Builder is
      for Executable ("main.adb") use "ada_app.o";
   end Builder;

   package Binder is
      for Switches ("Ada") use ("-D16k", "-Q2", "-Mada_main");
   end Binder;

   package Compiler is
      for Switches ("Ada") use ("-O2", "-g", "-gnata", "-gnat2022");
   end Compiler;

   package Linker is
      for Default_Switches ("Ada") use ("-Wl,-r", "-nostdlib");
   end Linker;
end SXOS;
