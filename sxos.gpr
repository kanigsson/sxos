with "../ada_esp32s3/crates/esp32s3_rts/esp32s3_rts.gpr";
with "../ada_esp32s3/libs/esp32s3_hal/esp32s3_hal.gpr";
with "vendor/inflate.gpr";

--  sxos, a bare-metal e-reader for the Xteink X4 Pro (ESP32-S3).  The
--  portable units in src/core are written in the SPARK subset, but no proofs
--  are run; src/device holds the hardware drivers.
project SXOS is
   for Target use "xtensa-esp32-elf";
   for Runtime ("Ada") use Esp32s3_Rts.Runtime_Path;
   for Source_Dirs use ("src/core", "src/device");
   for Object_Dir use "obj";
   for Main use ("main.adb");

   package Builder is
      for Executable ("main.adb") use "ada_app.o";
   end Builder;

   package Binder is
      for Switches ("Ada") use ("-D16k", "-Q2", "-Mada_main");
   end Binder;

   package Compiler is
      --  No -gnata on the target: contracts are checked in the host
      --  preview build, which compiles the same core.
      for Switches ("Ada") use ("-O2", "-g", "-gnat2022");
   end Compiler;

   package Linker is
      for Default_Switches ("Ada") use ("-Wl,-r", "-nostdlib");
   end Linker;
end SXOS;
